{
  "description": "Route resolution cases run by both test/route_resolver_test.dart and test/js/lite_engine.test.mjs, so the app and the page engine resolve paths the same way. Routes use the engine config format. In targets, $1 to $9 are capture groups; a group that did not take part in the match, or does not exist, becomes empty. Routes marked signedOut only apply when no session cookie is set; cases are signed in unless they say otherwise.",
  "session": ["SID"],
  "routes": [
    { "id": "reels", "match": "^/reels(?:[/?]|$)", "action": "block", "to": "/", "label": "Reels" },
    { "id": "explore", "match": "^/explore/?(?:\\?.*)?$", "action": "redirect", "to": "/explore/search/", "label": "Explore" },
    { "id": "feeds", "match": "^/explore/(?:tags|locations)/", "action": "block", "to": "/explore/search/", "label": "Explore feeds" },
    { "id": "home", "match": "^/(?:\\?(?!variant=).*)?$", "action": "redirect", "to": "/?variant=following", "label": "Home" },
    { "id": "self", "match": "^/self/$", "action": "redirect", "to": "/self/", "label": "Self" },
    { "id": "cycleA", "match": "^/cycle-a/$", "action": "block", "to": "/cycle-b/", "label": "Cycle A" },
    { "id": "cycleB", "match": "^/cycle-b/$", "action": "block", "to": "/cycle-a/", "label": "Cycle B" },
    { "id": "short", "match": "^/shorts/([A-Za-z0-9_-]+)", "action": "redirect", "to": "/watch?v=$1", "label": "Shorts" },
    { "id": "channelShorts", "match": "^/(@[^/?]+|channel/[^/?]+)/shorts/?(?:\\?.*)?$", "action": "redirect", "to": "/$1/videos", "label": "Shorts" },
    { "id": "optional", "match": "^/opt/(x)?y/$", "action": "redirect", "to": "/got/$1/$2/", "label": "Optional" },
    { "id": "subsHome", "match": "^/subs-home/$", "action": "redirect", "to": "/feed/subscriptions", "label": "Home" },
    { "id": "signedOutSubs", "match": "^/feed/subscriptions(?:[/?]|$)", "action": "redirect", "to": "/feed/library", "label": "Subscriptions", "signedOut": true }
  ],
  "cases": [
    { "path": "/", "expect": { "path": "/?variant=following", "changed": true, "blocked": null } },
    { "path": "/?deoia=1", "expect": { "path": "/?variant=following", "changed": true, "blocked": null } },
    { "path": "/?deoia=1&almsg=ias", "expect": { "path": "/?variant=following", "changed": true, "blocked": null } },
    { "path": "/?variant=following", "expect": { "path": "/?variant=following", "changed": false, "blocked": null } },
    { "path": "/?variant=favorites", "expect": { "path": "/?variant=favorites", "changed": false, "blocked": null } },
    { "path": "/reels/", "expect": { "path": "/?variant=following", "changed": true, "blocked": "Reels" } },
    { "path": "/reels", "expect": { "path": "/?variant=following", "changed": true, "blocked": "Reels" } },
    { "path": "/reels/C8xYz12AbC/", "expect": { "path": "/?variant=following", "changed": true, "blocked": "Reels" } },
    { "path": "/reels?utm_source=ig", "expect": { "path": "/?variant=following", "changed": true, "blocked": "Reels" } },
    { "path": "/reel/C8xYz12AbC/", "expect": { "path": "/reel/C8xYz12AbC/", "changed": false, "blocked": null } },
    { "path": "/reelsfan/", "expect": { "path": "/reelsfan/", "changed": false, "blocked": null } },
    { "path": "/someone/reels/", "expect": { "path": "/someone/reels/", "changed": false, "blocked": null } },
    { "path": "/explore/", "expect": { "path": "/explore/search/", "changed": true, "blocked": null } },
    { "path": "/explore", "expect": { "path": "/explore/search/", "changed": true, "blocked": null } },
    { "path": "/explore/?hl=en", "expect": { "path": "/explore/search/", "changed": true, "blocked": null } },
    { "path": "/explore/search/", "expect": { "path": "/explore/search/", "changed": false, "blocked": null } },
    { "path": "/explore/search/keyword/?q=cats", "expect": { "path": "/explore/search/keyword/?q=cats", "changed": false, "blocked": null } },
    { "path": "/explore/tags/cats/", "expect": { "path": "/explore/search/", "changed": true, "blocked": "Explore feeds" } },
    { "path": "/direct/inbox/", "expect": { "path": "/direct/inbox/", "changed": false, "blocked": null } },
    { "path": "/self/", "expect": { "path": "/self/", "changed": false, "blocked": null } },
    { "path": "/cycle-a/", "expect": { "path": "/cycle-b/", "changed": true, "blocked": "Cycle A" } },
    { "path": "/shorts/aB3_x-9", "expect": { "path": "/watch?v=aB3_x-9", "changed": true, "blocked": null } },
    { "path": "/shorts/aB3_x-9?feature=share", "expect": { "path": "/watch?v=aB3_x-9", "changed": true, "blocked": null } },
    { "path": "/@someone/shorts", "expect": { "path": "/@someone/videos", "changed": true, "blocked": null } },
    { "path": "/channel/UC123/shorts/?view=0", "expect": { "path": "/channel/UC123/videos", "changed": true, "blocked": null } },
    { "path": "/@someone/videos", "expect": { "path": "/@someone/videos", "changed": false, "blocked": null } },
    { "path": "/opt/xy/", "expect": { "path": "/got/x//", "changed": true, "blocked": null } },
    { "path": "/opt/y/", "expect": { "path": "/got///", "changed": true, "blocked": null } },
    { "path": "/feed/subscriptions", "expect": { "path": "/feed/subscriptions", "changed": false, "blocked": null } },
    { "path": "/feed/subscriptions", "signedIn": false, "expect": { "path": "/feed/library", "changed": true, "blocked": null } },
    { "path": "/feed/subscriptions?flow=1", "signedIn": false, "expect": { "path": "/feed/library", "changed": true, "blocked": null } },
    { "path": "/feed/library", "signedIn": false, "expect": { "path": "/feed/library", "changed": false, "blocked": null } },
    { "path": "/subs-home/", "expect": { "path": "/feed/subscriptions", "changed": true, "blocked": null } },
    { "path": "/subs-home/", "signedIn": false, "expect": { "path": "/feed/library", "changed": true, "blocked": null } },
    { "path": "/reels/", "signedIn": false, "expect": { "path": "/?variant=following", "changed": true, "blocked": "Reels" } }
  ]
}
